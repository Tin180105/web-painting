.admin-body {
    margin: 0;
    background: var(--paper);
}

.admin-wrapper {
    display: flex;
    min-height: 100vh;
}

/* ===== Sidebar ===== */
.admin-sidebar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    width: 240px;
    flex-shrink: 0;

    padding: 24px 18px;

    background: var(--ink);
    color: #f1f4f2;
}

.admin-sidebar-brand {
    margin-bottom: 30px;
}

.admin-sidebar-brand span {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 20px;
    font-weight: 700;
    color: #fff;
}

.admin-sidebar-brand small {
    color: #9fb0ac;
    font-size: 13px;
}

.admin-menu {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
}

.admin-menu a {
    display: flex;
    align-items: center;
    gap: 10px;

    padding: 10px 14px;
    border-radius: 6px;
    color: #e5ece9;
    font-weight: 600;
    text-decoration: none;
    transition: background .2s ease, color .2s ease;
}

.admin-menu-icon {
    flex: 0 0 auto;
    color: #9fb0ac;
    transition: color .2s ease;
}

.admin-menu a:hover {
    background: rgba(255, 255, 255, .08);
}

.admin-menu a.active {
    background: var(--teal);
    color: #fff;
}

.admin-menu a.active .admin-menu-icon,
.admin-menu a:hover .admin-menu-icon {
    color: #fff;
}

.admin-sidebar-footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, .12);
    font-size: 14px;
    color: #cbd5d2;
}

.admin-sidebar-user {
    display: flex;
    align-items: center;
    gap: 10px;
}

.admin-avatar {
    display: grid;
    place-items: center;
    flex: 0 0 auto;

    width: 32px;
    height: 32px;

    border-radius: 50%;

    background: var(--teal);
    color: #fff;

    font-size: 14px;
    font-weight: 700;
}

.admin-logout-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    padding: 8px 12px;

    border-radius: 6px;
    background: var(--coral);
    color: #fff;

    font-weight: 700;
    text-decoration: none;
}

.admin-logout-btn:hover {
    background: var(--coral-dark);
}

/* ===== Content ===== */
.admin-content {
    flex: 1;
    padding: 32px 40px;
    max-width: 1200px;
}

.admin-content h1 {
    font-size: 30px;
    margin-bottom: 20px;
}

/* ===== Topbar (trang tổng quan) ===== */
.admin-topbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;

    margin-bottom: 28px;
}

.admin-topbar-eyebrow {
    margin: 0 0 6px;
    color: var(--coral-dark);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
}

.admin-topbar h1 {
    margin: 0 0 6px;
}

.admin-topbar-sub {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
}

.admin-view-store {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;

    min-height: 40px;
    padding: 0 16px;

    border: 1px solid var(--line-dark);
    border-radius: 7px;

    background: #fff;
    color: var(--ink-light);

    font-size: 14px;
    font-weight: 700;
    text-decoration: none;

    transition: border-color .2s ease, color .2s ease, transform .2s ease;
}

.admin-view-store:hover {
    border-color: var(--teal);
    color: var(--teal);
    transform: translateY(-1px);
}

/* ===== Stat cards (dashboard) ===== */
.admin-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 34px;
}

.admin-stat-card {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.stat-icon {
    display: inline-grid;
    place-items: center;

    width: 38px;
    height: 38px;

    margin-bottom: 14px;

    border-radius: 9px;
}

.stat-icon-teal { background: var(--teal-light); color: var(--teal); }
.stat-icon-gold { background: #fbf0dc; color: #b9852c; }
.stat-icon-coral { background: #fce7e0; color: var(--coral-dark); }
.stat-icon-ink { background: #ecefee; color: var(--ink-light); }
.stat-icon-teal-dark { background: var(--teal-light); color: var(--teal-dark); }
.stat-icon-danger { background: #fbe4e6; color: var(--danger); }

.admin-stat-label {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
}

.admin-stat-value {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    color: var(--teal-dark);
}

/* ===== Dashboard two-column layout ===== */
.admin-dashboard-columns {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    align-items: start;
    gap: 24px;
}

.admin-panel {
    padding: 22px 24px;

    border: 1px solid var(--line);
    border-radius: var(--radius);

    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.admin-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    margin-bottom: 16px;
}

.admin-panel-head h2 {
    margin: 0;
    font-size: 19px;
}

.admin-panel-head a {
    color: var(--teal);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
}

.admin-panel-head a:hover {
    color: var(--teal-dark);
}

.admin-panel-empty {
    margin: 0;
    padding: 20px 0;
    color: var(--muted);
    font-size: 14px;
    text-align: center;
}

.admin-table-link {
    color: var(--teal);
    font-weight: 700;
    text-decoration: none;
}

.admin-table-link:hover {
    color: var(--teal-dark);
}

/* ===== Status badges (đơn hàng) ===== */
.status-badge {
    display: inline-flex;
    align-items: center;

    padding: 4px 10px;

    border-radius: 20px;

    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.status-pending { background: #fbf0dc; color: #96701f; }
.status-confirmed { background: var(--teal-light); color: var(--teal-dark); }
.status-shipping { background: #e3edfb; color: #2a5db0; }
.status-completed { background: #e1f3ee; color: #1c7a63; }
.status-cancelled { background: #fbe4e6; color: #b3303c; }

/* ===== Attention panel (dashboard sidebar) ===== */
.attention-item {
    display: flex;
    align-items: center;
    gap: 10px;

    padding: 10px 0;

    border-bottom: 1px solid var(--line);

    color: var(--ink);
    text-decoration: none;
}

.attention-item:last-child {
    border-bottom: none;
}

.attention-item-static {
    cursor: default;
}

.attention-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;

    width: 28px;
    height: 28px;

    border-radius: 50%;
}

.attention-icon-gold { background: #fbf0dc; color: #b9852c; }
.attention-icon-danger { background: #fbe4e6; color: var(--danger); }
.attention-icon-muted { background: #ecefee; color: var(--ink-light); }

.attention-text {
    flex: 1;
    min-width: 0;

    font-size: 14px;
    line-height: 1.3;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.attention-text small {
    display: block;
    color: var(--muted);
    font-size: 12px;
}

.attention-arrow {
    flex: 0 0 auto;
    color: var(--muted-light);
}

.attention-item:hover .attention-arrow {
    color: var(--teal);
}

.attention-subhead {
    margin: 14px 0 4px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
}

/* ===== Table dùng chung cho các trang admin ===== */
.admin-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.admin-table th,
.admin-table td {
    padding: 12px 15px;
    border-bottom: 1px solid #eee;
    text-align: left;
    vertical-align: middle;
    font-size: 14px;
}

.admin-table th {
    background: #f6f8f6;
    font-weight: 700;
}

.admin-table tr:last-child td {
    border-bottom: none;
}

.admin-panel .admin-table {
    box-shadow: none;
    border: none;
}

.admin-panel .admin-table th {
    background: transparent;
    color: var(--muted);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .04em;
}

/* ===== Responsive ===== */
@media (max-width: 1024px) {
    .admin-dashboard-columns {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 800px) {
    .admin-wrapper {
        flex-direction: column;
    }

    .admin-sidebar {
        width: 100%;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
    }

    .admin-menu {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .admin-content {
        padding: 24px 18px;
    }

    .admin-topbar {
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
    }
}

/* ===== Chart panel (doanh số theo tháng) ===== */
.admin-chart-panel {
    margin-bottom: 24px;
}

.admin-chart-filter select {
    min-height: 36px;
    padding: 0 10px;
    border: 1px solid var(--line-dark);
    border-radius: 6px;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
}

/* ===== Form thêm/sửa (dùng cho trang admin/categories/create, edit) ===== */
.admin-form-card {
    max-width: 640px;
    padding: 26px 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.admin-form-card .form-field {
    margin-bottom: 18px;
}

.admin-form-card label {
    display: block;
    margin-bottom: 7px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
}

.admin-form-card input[type="text"],
.admin-form-card textarea {
    width: 100%;
    max-width: none;
    padding: 10px 13px;
    border: 1px solid #d8d9d2;
    border-radius: 6px;
    background: #fff;
    color: var(--ink);
    font: inherit;
}

.admin-form-card textarea {
    min-height: 110px;
    resize: vertical;
}

.admin-form-card input:focus,
.admin-form-card textarea:focus {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(28, 116, 115, .10);
}

.admin-form-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 6px;
}

.admin-form-submit {
    min-height: 42px;
    padding: 10px 22px;
    border: 0;
    border-radius: 6px;
    background: var(--coral);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    transition: background .2s ease, transform .2s ease;
}

.admin-form-submit:hover {
    background: var(--coral-dark);
    transform: translateY(-1px);
}

.admin-form-back {
    color: var(--muted);
    font-weight: 600;
    text-decoration: none;
}

.admin-form-back:hover {
    color: var(--teal);
}

.admin-form-preview {
    margin-top: 10px;
}

.admin-form-preview img {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #eee;
}

/* ===== Modal (popup) dùng cho Thêm / Sửa / Xóa ở trang admin ===== */
.admin-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;

    display: flex;
    align-items: flex-start;
    justify-content: center;

    padding: 60px 20px;
    overflow-y: auto;

    background: rgba(32, 42, 45, .55);
    backdrop-filter: blur(3px);

    opacity: 0;
    pointer-events: none;

    transition: opacity .2s ease;
}

.admin-modal-overlay.show {
    opacity: 1;
    pointer-events: auto;
}

.admin-modal {
    width: min(560px, 100%);
    max-height: calc(100vh - 120px);
    overflow-y: auto;

    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);

    transform: translateY(-16px);
    transition: transform .2s ease;
}

.admin-modal-overlay.show .admin-modal {
    transform: translateY(0);
}

.admin-modal-header {
    position: sticky;
    top: 0;
    z-index: 1;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;

    padding: 20px 24px;

    border-bottom: 1px solid var(--line);
    background: var(--surface);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.admin-modal-header h2 {
    margin: 0;
    font-size: 21px;
}

.admin-modal-close {
    display: grid;
    place-items: center;
    flex: 0 0 auto;

    width: 32px;
    height: 32px;

    border: none;
    border-radius: 50%;

    background: #f1f3f1;
    color: var(--ink-light);

    font-size: 20px;
    line-height: 1;
    cursor: pointer;

    transition: background .2s ease, color .2s ease;
}

.admin-modal-close:hover {
    background: var(--coral);
    color: #fff;
}

.admin-modal-body {
    padding: 24px;
}

/* Form card khi nằm trong modal thì bỏ khung/border/shadow riêng vì modal đã có khung rồi */
.admin-modal-body .admin-form-card {
    max-width: none;
    padding: 0;
    border: none;
    box-shadow: none;
}

.admin-message-error {
    margin: 0 0 20px;
    padding: 12px 16px;
    border-left: 3px solid var(--danger);
    border-radius: 4px;
    background: #fbe4e6;
    color: #9d3d2b;
    font-size: 14px;
}

.modal-loading {
    padding: 40px 0;
    color: var(--muted);
    text-align: center;
}

.modal-confirm p {
    margin: 0 0 22px;
    color: var(--ink-light);
    line-height: 1.6;
}

.modal-confirm-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
}

.modal-confirm-actions button {
    min-height: 40px;
    padding: 9px 18px;

    border: 1px solid var(--line-dark);
    border-radius: 6px;

    background: #fff;
    color: var(--ink);

    font: inherit;
    font-weight: 700;
    cursor: pointer;

    transition: background .2s ease, border-color .2s ease;
}

.modal-confirm-actions .btn-cancel-confirm:hover {
    background: #f1f3f1;
}

.modal-confirm-actions .btn-danger-confirm {
    border-color: var(--danger);
    background: var(--danger);
    color: #fff;
}

.modal-confirm-actions .btn-danger-confirm:hover {
    background: #c22834;
}